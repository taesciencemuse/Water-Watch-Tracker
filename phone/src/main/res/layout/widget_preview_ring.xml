<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview only (Oct 30). Static, representative
     data — the real Glance widget renders live data once placed.
     RemoteViews-compatible views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/preview_ring" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="38%"
        android:textColor="@color/widget_text"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24 / 64 oz"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="40 oz to go"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="14sp" />
</LinearLayout>
