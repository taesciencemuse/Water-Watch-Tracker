<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect: phone is the writer. -->
    <!-- Notifications: REQUIRED for the permission to exist at all.
         Without this declaration, Android never lists Notifications
         in Settings > Apps > Water Logged > Permissions, the
         RequestPermission dialog never appears, and notify() is
         silently dropped on Android 13+. This was the v13/v14 bug:
         the code requested POST_NOTIFICATIONS but the manifest
         never declared it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />

    <!-- Package visibility for the Health Connect provider app (needed on
         Android 13 and below; harmless on newer versions). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:label="Water Logged"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Health Connect rationale screen (Android 14+ standard). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy-policy / permission-usage link (Android 14+ standard).
             Points back at MainActivity; required for the Health Connect
             permissions screen to link to this app's usage explanation. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Receives watch taps over the Wear Data Layer. -->
        <service
            android:name=".WatchMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/hydro/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- Home screen widgets (Glance; four variants, Oct 30, 2026).
             The legacy WaterWidget receiver is the Ring variant, so
             an already-placed widget migrates to the ring. -->
        <receiver
            android:name=".WaterWidgetReceiver"
            android:exported="true"
            android:label="Water Logged — Ring">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>
        <receiver
            android:name=".WaveWidgetReceiver"
            android:exported="true"
            android:label="Water Logged — Wave">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wave_widget_info" />
        </receiver>
        <receiver
            android:name=".RingQuickAddWidgetReceiver"
            android:exported="true"
            android:label="Water Logged — Ring + Quick Add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ring_quick_add_widget_info" />
        </receiver>
        <receiver
            android:name=".TileQuickAddWidgetReceiver"
            android:exported="true"
            android:label="Water Logged — Quick Add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tile_quick_add_widget_info" />
        </receiver>

        <!-- Quick Settings Tile (v13, item 3). -->
        <service
            android:name=".WaterQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="Water +8"
            android:permission="android.service.quicksettings.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Launcher shortcut target (v13, item 4): NoDisplay, logs and finishes.
             Flash fix (Oct 30): no window at all, so tapping the shortcut
             cannot flash a window band the way the old translucent
             activity did. -->
        <activity
            android:name=".ShortcutLogActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Notification +8 action (v12 item 1). Not exported: only
             this app's own PendingIntents can trigger it. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

    </application>
</manifest>
